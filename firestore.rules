rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function ownsUser(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validSessionRecord() {
      return request.resource.data.keys().hasAll([
          'ownerUid',
          'playerId',
          'sessionNumber',
          'depositAmount',
          'amountReturned',
          'withdrawnAmount',
          'games',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'ownerUid',
          'playerId',
          'sessionNumber',
          'depositAmount',
          'amountReturned',
          'withdrawnAmount',
          'games',
          'createdAt'
        ])
        && request.resource.data.ownerUid is string
        && request.resource.data.playerId is string
        && request.resource.data.sessionNumber is number
        && request.resource.data.depositAmount is number
        && request.resource.data.depositAmount > 0
        && request.resource.data.depositAmount <= 15000
        && request.resource.data.amountReturned is number
        && request.resource.data.amountReturned >= 0
        && request.resource.data.withdrawnAmount is number
        && request.resource.data.withdrawnAmount >= 0
        && request.resource.data.games is list
        && request.resource.data.games.size() > 0
        && request.resource.data.createdAt is timestamp;
    }

    match /game-users/{sessionId} {
      allow get, list: if ownsUser(resource.data.ownerUid);
      allow create: if ownsUser(request.resource.data.ownerUid)
        && validSessionRecord();
      allow update: if ownsUser(resource.data.ownerUid)
        && ownsUser(request.resource.data.ownerUid)
        && validSessionRecord();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
